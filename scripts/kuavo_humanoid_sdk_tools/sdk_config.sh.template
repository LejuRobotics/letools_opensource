#!/bin/bash
# sdk_config.sh.template - Kuavo Humanoid SDK 配置模板 (LeTools)
# 
# 📖 使用说明：
# 此文件由 install_sdk.sh 自动生成或手动修改。
# sdk_config.sh 已加入 .gitignore，不会被 git 跟踪。

# ============================================
# ROS 环境配置
# ============================================

# ROS devel 目录路径（相对于 LeTools 项目根目录）
export SDK_ROS_DEVEL_PATH="infrastructure/ros_packages/devel/"

# ROS installed 目录路径（相对于项目根目录）
export SDK_ROS_INSTALLED_PATH="infrastructure/ros_packages/installed/lib/python3/dist-packages"

# ============================================
# SDK 版本选择配置
# ============================================

# LeTools 配套的 kuavo-ros-opensource 版本由仓库自带的 sdk_version.env 决定
# （SDK_REPO_BRANCH + SDK_REPO_TAG 配对，随 LeTools 发版更新）。
# 以下两项默认留空即使用官方配套版本；
# 仅当开发者需要临时调试其他版本时，同时填写这两项进行显式覆盖（两项必须同时设置）。
export SDK_REPO_BRANCH=""
export SDK_REPO_TAG=""

# ============================================
# Git 版本获取配置
# ============================================

# ⚠️  重要：版本获取策略
# 💡 推荐设置："upstream" (从上游 submodule 获取，与代码来源一致)
export SDK_VERSION_STRATEGY="upstream"

# 如果以上策略都失败，使用的默认版本
# ⚠️  SDK_DEFAULT_VERSION 不是版本权威源：权威源是 sdk_version.env 的
#     SDK_REPO_BRANCH / SDK_REPO_TAG（当前 master / 1.4.5，见 sdk_version.env:26-27）。
#     两者不一致时，一律以 sdk_version.env 为准。
#     本常量只在「取不到上游版本」时才生效：setup_sdk.sh:88-90 要求先走过
#     setup_sdk.sh:71-86（策略为 upstream、SDK_REPO_TAG 为空、submodule 的
#     git describe 也取不到版本）仍未得到 VERSION；离线安装脚本
#     同理由 git describe 全失败触发。install_sdk.sh:136-137 会以 sdk_version.env 的
#     TARGET_TAG 透传给 setup_sdk.sh，正常安装路径下本常量不参与。
#     1.4.4 是历史遗留值（上游 master 上确实存在 tag 1.4.4，但配套版本已前移到
#     1.4.5），不要据此判断当前配套版本。
export SDK_DEFAULT_VERSION="1.4.4"

# ============================================
# pip 配置
# ============================================

# 是否自动备份原 pip 源
export SDK_BACKUP_PIP_SOURCE=true

# pip 镜像源（根据网络环境选择）
export SDK_PIP_MIRROR="https://pypi.tuna.tsinghua.edu.cn/simple/"

# ============================================
# 高级配置
# ============================================

# ROS 消息包名称（空格分隔）
# 注意：安装时只复制基础包，motion_capture_ik 作为运行时节点存在
export SDK_MSG_PACKAGES="kuavo_msgs ocs2_msgs"

# 是否安装可选依赖: "" (无), "audio", "vision", "full"
export SDK_EXTRAS=""
