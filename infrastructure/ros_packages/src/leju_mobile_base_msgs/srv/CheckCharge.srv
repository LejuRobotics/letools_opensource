# 充电到位查询（对齐实机 leju_mobile_base_msgs/CheckCharge，192.168.40.145 192.168.26.1
# ROS master 实测确认）。字段形状与 CheckArrived.srv 一致，仅 arrived 替换为 charging。
# 请求部分
bool blocking		#是否阻塞等待进入充电状态
float32 timeout        # 超时时间（秒，0表示无限等待）
---
# 响应部分
bool charging           # 是否正在充电
bool success		# 服务调用是否成功
string message         # 结果信息
int32 status		#当前状态枚举
