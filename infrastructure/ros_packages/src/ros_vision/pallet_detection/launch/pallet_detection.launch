<launch>
    <!-- 木托盘台面坐标系：彩色 + 深度 + camera_info → /pallet/detection -->
    <!-- 算法在 LeTools 的 skills/atomic/perception/pallet_detect/ 里 -->

    <arg name="image_color"   default="/camera/color/image_raw"/>
    <arg name="image_depth"   default="/camera/depth/image_raw"/>
    <arg name="camera_info"   default="/camera/color/camera_info"/>
    <arg name="detection_out" default="/pallet/detection"/>
    <!-- 非空时覆盖 Catkin 包装脚本的 /usr/bin/python3 shebang。 -->
    <arg name="python"        default=""/>
    <arg name="target_mm"     default="[1200.0, 1000.0]"/>

    <!-- 与画面近平行的托盘边是不是长边。**用户给出的先验，必须保留、必须传** ——
         现场事实：短边近平行、长边近垂直画面，所以部署值 = false。
         它定死**面内转角种子 θ0**；给错**明确偏 90°** 且不报错，换场景必须确认。
         ⚠️ **不能改成"两个候选都试、用残差挑"**：OBB 框的宽高比 ≈ 1，"哪条边是
         长边"在框上不可分，靠数据投票会让同一场景不同帧投出不同结果。见
         skills/atomic/perception/pallet_detect/solve_obb._seed_from_long_side。 -->
    <arg name="long_side_parallel" default="false"/>

    <!-- 法向：空串 = 从 TF 查（部署默认）。给 "x,y,z" 则直接用、不查 TF。
         ⚠️ 缺 TF 时节点**不发布**，不会回退到瞎猜的法向。
         ⚠️ OBB 路线把法向**锁死**成这个先验（frame_from_obb 的 4 自由度），
         所以偏了没有任何下游步骤会纠正它 —— 换工位 / 动腰后要重新确认。 -->
    <arg name="normal"        default=""/>
    <arg name="camera_frame"  default="camera_color_optical_frame"/>
    <arg name="base_frame"    default="base_link"/>

    <!-- 法向第二级：**TF 先验的 z 与托盘实际台面法向有 0~10° 的偏差，靠当前帧
         深度拟合纠正**（默认 true = 开）。OBB 路线把法向**锁死**成先验，偏了没有
         任何下游步骤会纠正它 —— 那 0~10° 会直接进位姿。关掉 = 用带偏差的 TF 法向。 -->
    <arg name="fit_normal"    default="true"/>
    <!-- false（默认）= 只在首帧拟合一次、之后复用（伺服只做平面内平移，朝向不变）。
         真动了腰 / 换了工位要设 true。 -->
    <arg name="normal_refit"  default="false"/>
    <!-- 首帧拟合的**合理性自检**（2026-10-22 现场事故后加）：拟合出的法向与
         相机光轴的夹角、拟合平面的距离都要说得通，才允许缓存。0 = 关掉对应闸。
         事故：TF 初值本身侧向、拟合与初值只差 0.05°，于是歪法向被缓存，
         D 恒为 241mm（ref=990），闸门把每一帧都拒掉（pub=0）。
         normal_d_check_tol 是**拟合平面距离**的相对容差，必须比发布用的
         d_tol（10%）宽 —— 拟合到的常是地面，地面与台面差 ~15%。 -->
    <arg name="normal_max_tilt_deg" default="60.0"/>
    <arg name="normal_d_check_tol" default="0.35"/>
    <!-- D 闸门拒绝时丢掉缓存法向、下一帧重新拟合（默认开）= 自愈。
         关掉就退回"拟歪一次永久生效，只能重启进程"的旧行为。 -->
    <arg name="normal_refit_on_d_reject" default="true"/>

    <!-- 托盘 OBB 模型（**必需**）。空 = 用包内 models/pallet_obb.onnx。
         模型缺失 / 加载失败时节点**起不来**（不静默降级）—— 缺了它没法检测，
         静默返回 None 会让"一直检不到"与"现场没有托盘"分不开。
         engine_path 空 = 包内 models/pallet_obb_fp32.engine（目标机上用 trtexec 导出）。
         infer_backend：auto = engine 文件在就用 engine、否则 ONNX；
                        engine = 强制 engine（缺了报错）；onnx = 强制 ONNX。 -->
    <arg name="model_path"    default=""/>
    <arg name="engine_path"   default=""/>
    <arg name="infer_backend" default="auto"/>
    <arg name="imgsz"         default="640"/>
    <arg name="conf"          default="0.25"/>
    <arg name="nms_iou"       default="0.45"/>
    <!-- 一帧多个候选时怎么挑：bottom_center(离画面下方中心最近) / conf / area -->
    <arg name="obb_pick"      default="bottom_center"/>

    <!-- ================= 两种前端（2026-10-18） =================
         detector=obb  —— **现行路径**：YOLO-OBB 初值 + 全 refine（~5Hz）。
         detector=pose —— **15Hz 路径**：YOLO-pose 12 关键点 → 四边解算 +
                          轻量 edge_refine（在 detect 内部做）。
                          该路线**建议 refine=false**（start_all.sh 按后端自动选
                          pallet_refine / pallet_pose_refine，不用手工改这里）。
         ⚠️ 只认 obb / pose；写错节点启动时 SystemExit。
         ⚠️ 两条路线的模型**不通用**：pose 必须另给 pose_model_path
            （空 = 包内 models/pallet_pose.onnx），缺失即起不来（不静默回退 OBB）。 -->
    <arg name="detector"      default="pose"/>
    <arg name="pose_model_path" default=""/>
    <arg name="pose_engine_path" default="/home/leju_kuavo/ztz/LeTools/skills/atomic/perception/pallet_detect/models/pallet_pose_fp32.engine"/>
    <arg name="pose_conf"     default="0.25"/>
    <arg name="pose_kconf"    default="0.5"/>
    <arg name="pose_edge_refine" default="true"/>
    <!-- pose 的选框口径，与 obb_pick 同一组取值 -->
    <arg name="pose_pick"     default="bottom_center"/>

    <!-- 检出后跑 refine（用户规则开关 + 脊线/角点/深度三级细化）。
         OBB 路线没有 plane 开关 —— 法向锁死，refine 不做平面细化。
         pose 路线建议 false（edge_refine 已在 detect 内做完）；由 start_all.sh
         按 detector 自动选 pallet_refine / pallet_pose_refine 的值再传进来。 -->
    <arg name="refine"        default="true"/>

    <!-- 心跳周期（秒）。**成功时也打**，用来把「在跑」与「线程死了 / 一直被拒」
         分开 —— 本节点原来的日志点全是一次性/只在失败时，正常工作时一片安静，
         与挂掉长得一模一样（2026-09-29 现场踩过）。0 = 关掉。 -->
    <arg name="heartbeat_s"   default="5.0"/>

    <!-- 检测门控（2026-10-18）：true = 只在伺服节点广播"这一档要托盘"（mode=2）
         之后才算、才发布；空闲时**启动先跑一帧预热**再待命。
         默认 false = 一直算（旧的独立 roslaunch 跑法行为不变）。
         ⚠️ 依赖 `std_msgs/Int32` 话题 `/pallet_servo/detect_mode`（伺服节点发，
         latched）。检测器先起也没关系 —— 拿到当前值之前按"关"处理。 -->
    <arg name="gated"         default="false"/>

    <!-- D 闸门：最终帧的平面距离 D（相机原点到**台面**、沿法向，毫米）与参考值的
         **最大相对偏差**。超过就不发布这一帧 —— 宁可不发，也不要送一个明显歪的
         位姿给伺服。D 是这条链里唯一"看图看不出来"的量（远近只表现为投影尺寸，
         而投影尺寸与"托盘多大"不可分），所以必须靠这个外部先验兜住。
         ⚠️ **890 是现场实测值**，换机位 / 动腰之后要重量（不同机位实测 ~650~1650mm）。
         给错不会崩，但会把所有帧判成超限、**一帧都不发布**，表现是"检测坏了"。
         节点启动会打一条 INFO 写明生效的 ref/tol，心跳里带实测 D（`d闸=N D=xxxmm`）。
         `d_mm <= 0` 或 `d_tol <= 0` = **关闸**。 -->
    <arg name="d_mm"          default="890.0"/>
    <arg name="d_tol"         default="0.1"/>

    <node name="pallet_detection" pkg="pallet_detection"
          type="pallet_detection_node.py" output="screen"
          launch-prefix="$(arg python)">
        <param name="image_color"        value="$(arg image_color)"/>
        <param name="image_depth"        value="$(arg image_depth)"/>
        <param name="camera_info"        value="$(arg camera_info)"/>
        <param name="detection_out"      value="$(arg detection_out)"/>
        <!-- ⚠️ `target_mm` **必须走 `<rosparam>`**，不能用 `<param value="..."/>`。
             roslaunch 的 `<param>` 不带 `type` 时按 `'auto'` 转换，而 `auto` 认不出
             list —— `"[1200.0, 1000.0]"` 会**原样变成字符串**（实测
             `roslaunch.loader.convert_value`），节点拿到它逐字符迭代，第一个字符
             就是 `[`：`ValueError: could not convert string to float: '['`，
             **节点起不来**。`<rosparam>` 走 YAML，给出的才是真正的 list。
             节点侧 `_parse_target_mm` 对两种形式都容错，但 launch 这一层也要写对 ——
             否则每次启动都靠节点的容错兜底，掩盖配置错误。 -->
        <rosparam param="target_mm" subst_value="true">$(arg target_mm)</rosparam>
        <param name="long_side_parallel" value="$(arg long_side_parallel)"/>
        <param name="normal"             value="$(arg normal)"/>
        <param name="fit_normal"         value="$(arg fit_normal)"/>
        <param name="normal_refit"       value="$(arg normal_refit)"/>
        <param name="normal_max_tilt_deg" value="$(arg normal_max_tilt_deg)"/>
        <param name="normal_d_check_tol" value="$(arg normal_d_check_tol)"/>
        <param name="normal_refit_on_d_reject" value="$(arg normal_refit_on_d_reject)"/>
        <param name="camera_frame"       value="$(arg camera_frame)"/>
        <param name="base_frame"         value="$(arg base_frame)"/>
        <param name="model_path"         value="$(arg model_path)"/>
        <param name="engine_path"        value="$(arg engine_path)"/>
        <param name="infer_backend"      value="$(arg infer_backend)"/>
        <param name="imgsz"              value="$(arg imgsz)"/>
        <param name="conf"               value="$(arg conf)"/>
        <param name="nms_iou"            value="$(arg nms_iou)"/>
        <param name="obb_pick"           value="$(arg obb_pick)"/>
        <param name="detector"           value="$(arg detector)"/>
        <param name="pose_model_path"    value="$(arg pose_model_path)"/>
        <param name="pose_engine_path"   value="$(arg pose_engine_path)"/>
        <param name="pose_conf"          value="$(arg pose_conf)"/>
        <param name="pose_kconf"         value="$(arg pose_kconf)"/>
        <param name="pose_edge_refine"   value="$(arg pose_edge_refine)"/>
        <param name="pose_pick"          value="$(arg pose_pick)"/>
        <param name="refine"             value="$(arg refine)"/>
        <param name="heartbeat_s"        value="$(arg heartbeat_s)"/>
        <param name="gated"              value="$(arg gated)"/>
        <param name="d_mm"               value="$(arg d_mm)"/>
        <param name="d_tol"              value="$(arg d_tol)"/>

        <!-- 本项目矩阵都太小，OpenBLAS 多线程是纯开销，实测差 1.6x -->
        <env name="OMP_NUM_THREADS" value="1"/>
        <env name="OPENBLAS_NUM_THREADS" value="1"/>
    </node>
</launch>
