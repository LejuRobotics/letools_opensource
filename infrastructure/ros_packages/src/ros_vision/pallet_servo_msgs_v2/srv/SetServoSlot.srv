# 切到哪个箱位 / 哪个箱型 / 初伺服还是最终伺服，观测托盘，或结束本次码放。
#
#   slot = 1..N  → 激活，用当前箱型槽位表里的第 N 档（第 N 个箱子）
#   slot = 0     → **观测托盘**：只等托盘检测，采若干帧把 base_link 系的
#                  D、托盘法向与**实测尺寸**写进文件（`pallet_record_path`），服务阻塞到
#                  记录完成/超时才返回；下一次 slot=0 会重新采样并覆盖旧记录。
#                  `box_type` / `stage` 在这一档**不参与**（托盘记录与箱型无关）
#   slot = -1    → **退出**本次码放，停止检测（话题上继续发 valid=false；
#                  **ok = true**，这不是错误）；托盘记录文件保留
#   其他（< -1 / 超出该箱型的档位数 / 未知箱型 / 非法 stage）→ 拒绝，ok=false，
#                  **当前状态不变**
#
# ⚠️ **服务从 1 数，槽位表从 0 数。** slot=2 用该箱型 slots[1]。
#    不同箱型有**各自独立**的槽位表与数量（例如箱型 A 5 位、箱型 B 12 位），
#    `slot` 只在当前 `box_type` 内编号。
#
# ⚠️ **box_type = 0 是默认箱型**：旧调用只写 `slot:` 时自动按箱型 0 处理。
#    未知箱型直接拒绝，不会退回 0 —— 静默退回会让三个数照样算得出来，
#    只是基准是另一个箱型的。
#
# ⚠️ **stage 默认 0 = 最终伺服**：旧调用只写 `slot:` 时行为与加这个字段。
#    之前完全一致。stage=1 是初伺服；两阶段的待伺服边可以在板子里分别配置，
#    但**只有最终伺服**会写入 `placed_slots` / 影响 `next_slot`。
#
# 节点启动时是**未激活**：没有 call 过之前一帧有效数据都不出，话题上发的是
# valid=false 的「伺服未启动」。这是刻意的 —— 隐式假设"默认第 1 档"，在
# 板子上加了箱位、或换场景从第 2 档开始时，会静默用错。
#
# slot=0 的记录文件跨开关机保留；启动时节点会加载并打印它。记录保存
# **base_link 系**的 D 和法向 —— 换工位 / 动腰后要重新 call 0。

# 阶段常量。服务端与 `pallet_servo_plan.STAGE_*` 必须逐字一致。
int32 STAGE_FINAL=0
int32 STAGE_INITIAL=1

int32 slot
int32 box_type
int32 stage
---
# 这次调用有没有生效。**false 时调用方要自己判断怎么办**（多半是退回去查
# 档位表，或者把箱位/箱型计数改对）。
bool ok

# 人话原因。ok=true 时也带一句（写清切到了哪个箱型、第几档、哪个阶段、
# 对应哪两条边），这样 `rosservice call` 的输出本身就是一条现场记录。
string message
