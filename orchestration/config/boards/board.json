{
    "inputs": [],
    "custom": [],
    "process": [
        {
            "key": "Common_BoxLength",
            "remark": "箱子长度(米)",
            "type": "float",
            "value": "0.35",
            "defaultValue": "0.35"
        },
        {
            "key": "Common_BoxWidth",
            "remark": "箱子宽度(米)",
            "type": "float",
            "value": "0.3",
            "defaultValue": "0.3"
        },
        {
            "key": "Common_BoxHeight",
            "remark": "箱子高度(米)",
            "type": "float",
            "value": "0.22",
            "defaultValue": "0.22"
        },
        {
            "key": "Common_BoxMass",
            "remark": "箱子质量(kg)",
            "type": "float",
            "value": "1.5",
            "defaultValue": "1.5"
        },
        {
            "key": "Common_robot_type",
            "remark": "机器人类型（如 'kuavo_lb'），影响导航模式选择",
            "type": "string",
            "value": "kuavo_lb",
            "defaultValue": "kuavo_lb"
        },
        {
            "key": "GraspBox_PickPoseStandEulerInTag",
            "remark": "抓箱抓取站立欧拉角 [r,p,y]（弧度）",
            "type": "string",
            "value": "-1.5708, 1.5708, 0",
            "defaultValue": "-1.5708, 1.5708, 0"
        },
        {
            "key": "GraspBox_PickPoseStandPositionInTag",
            "remark": "抓箱抓取站立位置 [x,y,z]（米）",
            "type": "string",
            "value": "0, 0, 0.8",
            "defaultValue": "0, 0, 0.8"
        },
        {
            "key": "GraspBox_PlacePoseStandEulerInTag",
            "remark": "抓箱放置站立欧拉角 [r,p,y]（弧度）",
            "type": "string",
            "value": "-1.5708, 1.5708, 0",
            "defaultValue": "-1.5708, 1.5708, 0"
        },
        {
            "key": "GraspBox_PlacePoseStandPositionInTag",
            "remark": "抓箱放置站立位置 [x,y,z]（米）",
            "type": "string",
            "value": "0, 0, 0.8",
            "defaultValue": "0, 0, 0.8"
        },
        {
            "key": "Head_PercepHalfFov",
            "remark": "感知半视场角度（度）",
            "type": "int",
            "value": "60",
            "defaultValue": "60"
        },
        {
            "key": "SMTSquatStandControl_PickPoseStandEulerInTag",
            "remark": "SMT抓取站立欧拉角 [r,p,y]（弧度）",
            "type": "string",
            "value": "-1.5708, 1.5708, 0",
            "defaultValue": "-1.5708, 1.5708, 0"
        },
        {
            "key": "SMTSquatStandControl_PickPoseStandPositionInTag",
            "remark": "SMT抓取站立位置 [x,y,z]（米）",
            "type": "string",
            "value": "0, 0, 0.6",
            "defaultValue": "0, 0, 0.6"
        },
        {
            "key": "SMTSquatStandControl_PlacePoseStandEulerInTag",
            "remark": "SMT放置站立欧拉角 [r,p,y]（弧度）",
            "type": "string",
            "value": "-1.5708, 1.5708, 0",
            "defaultValue": "-1.5708, 1.5708, 0"
        },
        {
            "key": "SMTSquatStandControl_PlacePoseStandPositionInTag",
            "remark": "SMT放置站立位置 [x,y,z]（米）",
            "type": "string",
            "value": "0, 0, 0.8",
            "defaultValue": "0, 0, 0.8"
        },
        {
            "key": "Head_HeadEventTimeout",
            "remark": "头部移动超时时间（秒）, 默认1000",
            "type": "int",
            "value": "3000",
            "defaultValue": "3000"
        },
        {
            "key": "Walk_WalkEventPosThreshold",
            "remark": "行走位置到达阈值（米）",
            "type": "float",
            "value": "0.10",
            "defaultValue": "0.10"
        },
        {
            "key": "Walk_WalkEventTimeout",
            "remark": "行走事件超时时间（秒）",
            "type": "int",
            "value": "50",
            "defaultValue": "50"
        },
        {
            "key": "Walk_WalkEventYawThreshold",
            "remark": "行走偏航角到达阈值（弧度）",
            "type": "float",
            "value": "0.2",
            "defaultValue": "0.2"
        },
        {
            "key": "Arm_AngleThreshold",
            "remark": "角度到达阈值（弧度）",
            "type": "float",
            "value": "0.5",
            "defaultValue": "0.5"
        },
        {
            "key": "Arm_ArmEventTimeout",
            "remark": "手臂移动事件超时时间（秒）",
            "type": "int",
            "value": "30",
            "defaultValue": "30"
        },
        {
            "key": "Arm_PoseThreshold",
            "remark": "位置到达阈值（米）",
            "type": "float",
            "value": "0.14",
            "defaultValue": "0.14"
        },
        {
            "key": "GraspBox_ForceRatioZ",
            "remark": "垂直方向力比",
            "type": "float",
            "unit": "比例",
            "value": "0.0",
            "defaultValue": "0.0",
            "example": "0.0"
        },
        {
          "key": "GraspBox_LateralForce",
          "remark": "侧向力",
          "type": "float",
          "unit": "N",
          "value": "0.0",
          "defaultValue": "0.0",
          "example": "0.0"
        }
    ]
}